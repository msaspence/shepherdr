{
  "id": "root",
  "type": "column",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_menu": "chat-menu",
  "floating": [
    {
      "id": "new-chat-commands",
      "content": {
        "mod": "new-chat",
        "props": {
          "role": "commands"
        }
      },
      "edge": "bottom",
      "align": "start"
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    14,
    13
  ],
  "resizable": false,
  "children": [
    {
      "id": "titlebar",
      "type": "column",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "titlebar-slot",
          "type": "row",
          "size": {
            "weight": 1
          },
          "resizable": false,
          "children": [
            {
              "id": "titlebar-main",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "agents-sidebar-titlebar"
              }
            },
            {
              "id": "titlebar-opens-in",
              "type": "block",
              "size": {
                "px": 200
              },
              "content": {
                "mod": "opens-in",
                "props": {
                  "variant": "horizontal-icons",
                  "path_shared": "agents-sidebar.active-cwd"
                }
              }
            },
            {
              "id": "titlebar-context-panel",
              "type": "block",
              "size": {
                "px": 46
              },
              "content": {
                "mod": "agents-sidebar-context-panel",
                "props": {
                  "variant": "toggle"
                }
              }
            }
          ]
        },
        {
          "id": "titlebar-rule",
          "type": "row",
          "size": {
            "px": 1
          },
          "background": "border",
          "children": []
        }
      ]
    },
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 268
          },
          "min": 46,
          "max": 480,
          "background": "chrome",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 40,
              "content": {
                "mod": "agents-sidebar-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 120,
              "content": {
                "mod": "agents-sidebar-agents"
              }
            }
          ],
          "resizable": false
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 0,
              "background": "background"
            }
          }
        }
      ],
      "resizable": false
    }
  ],
  "preview": "layouts/agents-sidebar.svg"
}
